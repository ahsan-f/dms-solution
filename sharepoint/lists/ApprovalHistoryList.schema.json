{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Approval History List",
    "type": "object",
    "properties": {
        "Action": {
            "type": "string"
        },
        "ReportID": {
            "type": "integer"
        },
        "ApproverID": {
            "type": "string"
        },
        "Timestamp": {
            "type": "string",
            "format": "date-time"
        }
    },
    "required": [
        "Action",
        "ReportID",
        "ApproverID",
        "Timestamp"
    ]
}